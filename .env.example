# The host console is passwordless; HOST_PASSWORD is not required.
PORT=3001
# Local SQLite database. Render Free storage is temporary and can be reset.
DATA_FILE=data/game.sqlite
# PostgreSQL/Supabase server-side connection (optional; replaces SQLite).
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# Public HTTPS origin for phone QR codes; no trailing path.
# PUBLIC_BASE_URL=https://game.example.com
# Optional extra trusted browser origins, comma-separated. Same-origin is default.
# ALLOWED_ORIGINS=https://game.example.com
# Leave empty to use the same-origin Vite/production Socket.IO endpoint.
VITE_SOCKET_URL=
